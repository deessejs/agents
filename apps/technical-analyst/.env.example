# ─── LLM provider (default: @ai-sdk/minimax, model minimax-m3) ─────────
# AI_GATEWAY_API_KEY=                    # optional: Vercel AI Gateway OIDC
# LLM_MODEL_ID=minimax-m3                # default per @workspace/llm/src/models.ts

# Optional: only if operator switches to AWS Bedrock for EU compliance
# BEDROCK_REGION=eu-central-1
# Optional: only if operator switches to Vertex AI for EU compliance
# GOOGLE_VERTEX_LOCATION=europe-west4

# ─── GitHub (Phase 2 — locked 2026-10-06) ──────────────────────────────
GITHUB_TOKEN=ghp_replace_me_with_fine_grained_PAT
GITHUB_ORG=deessejs

# ─── Resend (locked 2026-10-06) ──────────────────────────────────────
RESEND_API_KEY=re_replace_me_with_resend_key
RESEND_FROM_ADDRESS=digest@mail.deessejs.com
RESEND_FROM_NAME="Technical Analyst"
RESEND_REPLY_TO=nesalia.inc@gmail.com
# RESEND_WEBHOOK_SECRET=whsec_replace    # v2: Svix signing secret

# ─── Recipient (locked 2026-10-06) ──────────────────────────────────
DIGEST_RECIPIENT=nesalia.inc@gmail.com

# ─── List-Unsubscribe (RFC 8058) ───────────────────────────────────
UNSUBSCRIBE_BASE_URL=https://app.deessejs.com
UNSUBSCRIBE_MAILTO=unsubscribe@mail.deessejs.com

# ─── Cadence (UTC crons; locked 22:00 Paris daily, ~18:00 Paris Friday) ─
DAILY_CRON=0 20 * * *
WEEKLY_CRON=0 16 * * 5
DAILY_LOCAL_TIMEZONE=Europe/Paris

# ─── Cron security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=replace_me_with_a_random_32_byte_hex

# ─── Vercel KV ─────────────────────────────────────────────────────
KV_REST_API_URL=https://replace_me.kv.vercel-storage.com
KV_REST_API_TOKEN=replace_me

# ─── Optional kill-switch ──────────────────────────────────────────
# AGENTS_PAUSED=false
