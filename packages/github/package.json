    "./schemas/pull-request": "./src/schemas/pull-request.ts",
    "./schemas/issue": "./src/schemas/issue.ts",
    "./schemas/dependabot-alert": "./src/schemas/dependabot-alert.ts",
    "./schemas/code-scanning-alert": "./src/schemas/code-scanning-alert.ts",
    "./schemas/secret-scanning-alert": "./src/schemas/secret-scanning-alert.ts",
    "./schemas/release": "./src/schemas/release.ts",
    "./schemas/workflow-run": "./src/schemas/workflow-run.ts",
    "./schemas/user": "./src/schemas/user.ts",
    "./schemas/ref": "./src/schemas/ref.ts",
    "./api/pulls": "./src/api/pulls.ts",
    "./api/issues": "./src/api/issues.ts",
    "./api/repos": "./src/api/repos.ts",
    "./api/security": "./src/api/security.ts",
    "./api/releases": "./src/api/releases.ts",
    "./api/actions": "./src/api/actions.ts",
    "./api/stats": "./src/api/stats.ts",
    "./pagination": "./src/pagination.ts",
    "./throttle": "./src/throttle.ts",
    "./package.json": "./package.json"
