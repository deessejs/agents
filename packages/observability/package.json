{
  "name": "@workspace/observability",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tags": "./src/tags.ts",
    "./redact": "./src/redact.ts",
    "./otel": "./src/otel/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "echo '[@workspace/observability] no lint'",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@workspace/env": "workspace:*",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@workspace/tsconfig": "workspace:*",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
