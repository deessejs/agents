{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tsconfig.json",
        "package.json",
        "tsconfig.tsbuildinfo"
      ],
      "env": [
        "GITHUB_TOKEN",
        "GITHUB_ORG",
        "GITHUB_REPO",
        "RESEND_API_KEY",
        "RESEND_FROM_ADDRESS",
        "RESEND_FROM_NAME",
        "RESEND_REPLY_TO",
        "DIGEST_RECIPIENT",
        "MINIMAX_API_KEY",
        "LLM_MODEL_ID",
        "AGENTS_PAUSED"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "tests/**",
        "oxlint.config.ts",
        ".oxfmtrc.json",
        "tsconfig.json"
      ]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tsconfig.json", "package.json"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tests/**", "vitest.config.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
